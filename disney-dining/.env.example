# Show the browser window (true while developing, false for cron)
HEADLESS=false
# Browser profile folder that holds the Disney login (checker account)
PROFILE_DIR=local/profile
# Optional: use a storageState JSON instead of a profile (for the Oracle VM)
STORAGE_STATE=
# Discord webhook URL (Phase 4)
DISCORD_WEBHOOK_URL=
# Optional Discord user ID to @mention on availability alerts
DISCORD_MENTION_USER_ID=
# Pushover wake-up alerts (Phase 7). Leave both keys empty to turn Pushover off.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
# Seconds between repeats until acknowledged (minimum 30), and how long to keep repeating
# (maximum 10800). Defaults: 30 and 900.
PUSHOVER_RETRY_SEC=30
PUSHOVER_EXPIRE_SEC=900
# Optional Pushover sound name (for example persistent or siren). Empty uses the app's default.
PUSHOVER_SOUND=
# Minutes between checks in watch mode (Phase 5)
CHECK_INTERVAL_MIN=8
# debug | info | warn | error
LOG_LEVEL=info
